genes2<-fread("/Volumes/MRC-IEU-research/projects/icep2/wp2/034/working/results/Eosinophil/Colon_Transverse_PrediXcan.csv")
genes2$diffexpressed <- "None"
genes2$diffexpressed[genes2$effect_size>0 & genes2$pvalue<(0.05/length(unique(genes2$gene)))] <- "Upregulated"
genes2$diffexpressed[genes2$effect_size<0 & genes2$pvalue<(0.05/length(unique(genes2$gene)))] <- "Downregulated"
genes<-rbind(genes1,genes2)
genes<-genes[order(genes$pvalue),]
genes<-genes[!duplicated(genes$gene),]
p <- ggplot(data=genes, aes(x=effect_size, y=-log10(pvalue), col=diffexpressed)) + geom_point() + theme_minimal() + theme(text = element_text(size=20))+ scale_color_manual("Differential expression",values=rev(c("red", "grey", "blue")))
#p <- p  + geom_text_repel(size=5,max.overlaps = 5000000,direction="x",nudge_x = -0.5,show.legend = FALSE)
p <- p + xlab("Effect size") + ylab("-log10 P Value")
p
ggsave(filename="~/OneDrive - University of Bristol/Documents/Year 3/Eosinophil CRC genes/TWAS_plot.png", plot=last_plot(),width = 0.8*300, height = 0.8*200, units = "mm",bg="white")
