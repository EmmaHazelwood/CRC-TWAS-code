library(dplyr)
library(ggplot2)
library(data.table)
# TWAS --------------------------------------------------------------------
genes1<-fread("/Volumes/MRC-IEU-research/projects/icep2/wp2/034/working/results/Eosinophil/Colon_Sigmoid_PrediXcan.csv")
genes1$diffexpressed <- "None"
genes1$diffexpressed[genes1$pvalue<(0.05/length(unique(genes1$gene)))] <- "Upregulated"
genes1$diffexpressed[genes1$pvalue<(0.05/length(unique(genes1$gene)))] <- "Downregulated"
genes2<-fread("/Volumes/MRC-IEU-research/projects/icep2/wp2/034/working/results/Eosinophil/Colon_Transverse_PrediXcan.csv")
genes2$diffexpressed <- "None"
genes2$diffexpressed[genes2$pvalue<(0.05/length(unique(genes2$gene)))] <- "Upregulated"
genes2$diffexpressed[genes2$pvalue<(0.05/length(unique(genes2$gene)))] <- "Downregulated"
genes<-rbind(genes1,genes2)
genes<-genes[order(genes$pvalue),]
genes<-genes[!duplicated(genes$gene),]
p <- ggplot(data=genes, aes(x=effect_size, y=-log10(pvalue), col=diffexpressed)) + geom_point() + theme_minimal() + theme(text = element_text(size=20))+ scale_color_manual("Differential Expression",values=rev(c("red", "grey", "blue")))
#p <- p  + geom_text_repel(size=5,max.overlaps = 5000000,direction="x",nudge_x = -0.5,show.legend = FALSE)
p <- p + xlab("Log Fold Change") + ylab("-log10 P Value")
p
